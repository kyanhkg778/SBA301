    {
      "name": "2. Rooms (Public View & Staff CRUD)",
      "item": [
        {
          "name": "Get Active Rooms (Public - No Auth Required)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/rooms",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "rooms"]
            }
          }
        },
        {
          "name": "Search Rooms (Public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/rooms?query=Deluxe&minPrice=500000&maxPrice=1000000",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "rooms"],
              "query": [
                { "key": "query", "value": "Deluxe" },
                { "key": "minPrice", "value": "500000" },
                { "key": "maxPrice", "value": "1000000" }
              ]
            }
