              "raw": "{\n  \"roomNumber\": \"501\",\n  \"roomDetailDescription\": \"Phòng Penthouse cao cấp có ban công riêng\",\n  \"roomMaxCapacity\": 4,\n  \"roomTypeId\": 3,\n  \"roomStatus\": 1,\n  \"roomPricePerDay\": 2500000.00\n}"
